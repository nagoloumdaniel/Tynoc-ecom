{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TableItemsReadWrite",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:BatchGetItem",
        "dynamodb:Query",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:BatchWriteItem"
      ],
      "Resource": "arn:aws:dynamodb:eu-west-3:ACCOUNT_ID:table/tynoc-ecom-prod"
    },
    {
      "Sid": "IndexesQueryOnly",
      "Effect": "Allow",
      "Action": ["dynamodb:Query"],
      "Resource": "arn:aws:dynamodb:eu-west-3:ACCOUNT_ID:table/tynoc-ecom-prod/index/*"
    }
  ]
}
