{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TableProvisioning",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:DescribeTable",
        "dynamodb:UpdateTimeToLive",
        "dynamodb:BatchWriteItem"
      ],
      "Resource": "arn:aws:dynamodb:eu-west-3:ACCOUNT_ID:table/tynoc-ecom-prod"
    }
  ]
}
