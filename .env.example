# ---------------------------------------------------------------------------
# Tynoc E-Commerce : modèle de configuration
#
# Copier ce fichier vers .env.local puis renseigner les valeurs.
# .env.local est ignoré par Git et ne doit JAMAIS être commité.
# ---------------------------------------------------------------------------

# --- AWS / DynamoDB --------------------------------------------------------
# Préfixe APP_AWS_ volontaire : le runtime Lambda de Vercel réserve les noms
# AWS_REGION / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
APP_AWS_REGION=eu-west-3
APP_AWS_ACCESS_KEY_ID=
APP_AWS_SECRET_ACCESS_KEY=

# Nom de la table (single-table design). Une table par environnement.
DYNAMODB_TABLE_NAME=tynoc-ecom-dev

# Développement hors ligne avec DynamoDB Local (optionnel).
# Laisser vide pour cibler le service AWS réel.
# DYNAMODB_ENDPOINT=http://localhost:8000

# --- Session ---------------------------------------------------------------
# Secret de signature du cookie de session. 32 caractères minimum.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Application -----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
